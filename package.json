{
  "name": "dsh-claude-codex-mode",
  "version": "0.4.0",
  "type": "module",
  "description": "Discussion stays read-only, and every repository code edit goes to Codex. The discussion runs on the DSH model or through the Claude Code CLI.",
  "author": "jiaoguo",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/hotheat/dsh-claude-codex-mode" },
  "homepage": "https://github.com/hotheat/dsh-claude-codex-mode",
  "bugs": { "url": "https://github.com/hotheat/dsh-claude-codex-mode/issues" },
  "engines": { "node": ">=20", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "mcp", "scripts", "test", "locale", "cordis.patch.yml", "icon.svg", "LICENSE", "README.md", "README.zh-CN.md", "ATTRIBUTION.md", "CHANGELOG.md"],
  "scripts": {
    "test": "node test/policy.mjs && node --test test/preflight.mjs test/doctor.mjs test/client.mjs test/codex-events.mjs test/schemas.mjs test/codex-tools.mjs && node test/cordis-load.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
